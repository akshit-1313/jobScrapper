{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-discovery",
      "schedule": "0 4 * * *"
    }
  ],
  "env": {
    "PROFILE_SEARCH_TIMEOUT_SECONDS": "55",
    "PROFILE_EXTRACTION_RESERVATION_SECONDS": "45"
  },
  "functions": {
    "src/app/api/cron/daily-discovery/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/discovery/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/integration-worker/route.ts": {
      "maxDuration": 60
    }
  }
}
